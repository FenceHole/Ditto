# Simple Configuration for Facebook Marketplace Only
# Copy this to .env and fill in your values

# REQUIRED: Anthropic API for AI photo analysis and listing generation
# Get your key at: https://console.anthropic.com
# Cost: ~$5-20/month depending on usage
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# REQUIRED for auto-posting: Facebook Marketplace API
# See setup guide in README.md
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# Server settings (leave as-is)
HOST=0.0.0.0
PORT=8000
DEBUG=true

# OPTIONAL: eBay for price research (not needed for basic use)
# EBAY_APP_ID=
# EBAY_CERT_ID=
# EBAY_DEV_ID=
