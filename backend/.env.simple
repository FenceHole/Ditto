# Configuration — copy this file to ".env" and fill in your values.

# ── REQUIRED ──────────────────────────────────────────────────────────────
# Google Gemini API key — powers photo analysis + listing writing.
# Get it FREE (no credit card) at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_free_gemini_api_key_here

# ── OPTIONAL: integration auth ────────────────────────────────────────────
# If set, callers (e.g. your "nessie" automation) must send header:
#   X-API-Key: <this value>
# Leave blank for open local use.
APP_API_KEY=

# ── Server settings (leave as-is) ─────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ── OPTIONAL: browser poster for a DEDICATED Facebook account ─────────────
# Facebook has NO API for posting personal Marketplace listings. This drives a
# real browser and is against Facebook's ToS — it can get an account BANNED.
# NEVER use your main/business account. Off unless you set this to true.
ENABLE_BROWSER_POSTER=false
FB_DEDICATED_EMAIL=
FB_DEDICATED_PASSWORD=
# BROWSER_POSTER_HEADLESS=true
# BROWSER_POSTER_AUTOPUBLISH=false   # leave false to fill a draft for review

# ── OPTIONAL: eBay sold-price research (off by default) ───────────────────
# EBAY_APP_ID=
# EBAY_CERT_ID=
# EBAY_DEV_ID=
